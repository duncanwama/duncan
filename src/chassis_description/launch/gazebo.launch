<launch>
  <!-- Settings you can change from the command line, e.g. x:=1.0 -->
  <arg name="world" default="worlds/empty.world"/>
  <arg name="x"     default="0"/>
  <arg name="y"     default="0"/>
  <arg name="yaw"   default="0"/>
  <arg name="rviz"  default="false"/>

  <!-- 1. Start Gazebo (the server and the window) -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(arg world)"/>
    <arg name="paused"       value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui"          value="true"/>
  </include>

  <!-- 2. Robot description from Xacro -->
  <param name="robot_description"
         command="$(find xacro)/xacro $(find chassis_description)/urdf/chassis.urdf.xacro"/>

  <!-- 3. TF for the robot's links -->
  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="robot_state_publisher"/>

  <!-- 4. Put the robot into the world -->
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_chassis" output="screen"
        args="-urdf -param robot_description -model chassis
              -x $(arg x) -y $(arg y) -z 0.01 -Y $(arg yaw)"/>

  <!-- Optional: RViz with your saved layout -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find chassis_description)/rviz/chassis.rviz"/>
</launch>

