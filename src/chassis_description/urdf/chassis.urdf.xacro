<?xml version="1.0"?>
<robot name="chassis" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== 1. Properties ===================== -->
  <!-- Body -->
  <xacro:property name="body_length"      value="0.40"/>
  <xacro:property name="body_width"       value="0.30"/>
  <xacro:property name="body_height"      value="0.10"/>
  <xacro:property name="body_mass"        value="5.0"/>
  <xacro:property name="ground_clearance" value="0.03"/>
  <!-- Drive wheels -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_mass"   value="0.5"/>
  <xacro:property name="wheel_x"      value="0.12"/>   <!-- in front of the body centre -->
  <xacro:property name="wheel_gap"    value="0.005"/>  <!-- space between body and wheel -->
  <!-- Caster -->
  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_mass"   value="0.2"/>
  <xacro:property name="caster_x"      value="-0.15"/> <!-- behind the body centre -->
  <!-- Tray -->
  <xacro:property name="tray_length" value="0.30"/>
  <xacro:property name="tray_width"  value="0.24"/>
  <xacro:property name="tray_thick"  value="0.01"/>
  <xacro:property name="wall_height" value="0.04"/>
  <xacro:property name="wall_thick"  value="0.01"/>
  <xacro:property name="tray_mass"   value="0.5"/>
  <!-- Worked out from the numbers above -->
  <xacro:property name="body_z"  value="${ground_clearance + body_height/2}"/>        <!-- 0.08 -->
  <xacro:property name="wheel_y" value="${body_width/2 + wheel_width/2 + wheel_gap}"/> <!-- 0.175 -->
  <!-- LiDAR (Module 5) -->
  <xacro:property name="lidar_radius" value="0.025"/>
  <xacro:property name="lidar_length" value="0.04"/>
  <xacro:property name="lidar_mass"   value="0.1"/>
  <xacro:property name="lidar_x"      value="0.175"/>  <!-- the free strip in front of the tray -->
  <xacro:property name="lidar_z"      value="0.22"/>   <!-- beam height above the ground -->
  <xacro:property name="post_length"  value="${lidar_z - lidar_length/2 - (body_z + body_height/2)}"/>  <!-- 0.07 -->

  <!-- ===================== 2. Colours ===================== -->
  <material name="blue">   <color rgba="0.1 0.3 0.8 1"/></material>
  <material name="black">  <color rgba="0.1 0.1 0.1 1"/></material>
  <material name="grey">   <color rgba="0.6 0.6 0.6 1"/></material>
  <material name="orange"> <color rgba="1.0 0.5 0.0 1"/></material>

  <!-- ===================== 3. Inertia macros ===================== -->
  <!-- Standard formulas for solid shapes. Gazebo needs these to simulate. -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>   <!-- same turn as the wheel shape -->
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
               iyy="${2*m*r*r/5}" iyz="0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== 4. Body ===================== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== 5. Drive wheels (one macro, used twice) ===================== -->
  <xacro:macro name="wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <!-- A URDF cylinder stands upright; turn it 90 degrees about x to make a wheel -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <!-- wheel centre is wheel_radius above the ground -->
      <origin xyz="${wheel_x} ${y_reflect*wheel_y} ${wheel_radius - body_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>   <!-- spins about the y axis -->
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  y_reflect="1"/>
  <xacro:wheel prefix="right" y_reflect="-1"/>

  <!-- ===================== 6. Caster ===================== -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <!-- the ball touches the ground -->
    <origin xyz="${caster_x} 0 ${caster_radius - body_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== 7. Tray (carries the cube in the final task) ===================== -->
  <!-- One box for the tray: visual + collision -->
  <xacro:macro name="tray_part" params="x y z sx sy sz">
    <visual>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
    </collision>
  </xacro:macro>

  <link name="tray_link">
    <!-- floor plate -->
    <xacro:tray_part x="0" y="0" z="0" sx="${tray_length}" sy="${tray_width}" sz="${tray_thick}"/>
    <!-- front and back walls -->
    <xacro:tray_part x="${ tray_length/2 - wall_thick/2}" y="0" z="${tray_thick/2 + wall_height/2}"
                     sx="${wall_thick}" sy="${tray_width}" sz="${wall_height}"/>
    <xacro:tray_part x="${-tray_length/2 + wall_thick/2}" y="0" z="${tray_thick/2 + wall_height/2}"
                     sx="${wall_thick}" sy="${tray_width}" sz="${wall_height}"/>
    <!-- left and right walls -->
    <xacro:tray_part x="0" y="${ tray_width/2 - wall_thick/2}" z="${tray_thick/2 + wall_height/2}"
                     sx="${tray_length}" sy="${wall_thick}" sz="${wall_height}"/>
    <xacro:tray_part x="0" y="${-tray_width/2 + wall_thick/2}" z="${tray_thick/2 + wall_height/2}"
                     sx="${tray_length}" sy="${wall_thick}" sz="${wall_height}"/>
    <xacro:box_inertia m="${tray_mass}" x="${tray_length}" y="${tray_width}" z="${wall_height}"/>
  </link>

  <joint name="tray_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tray_link"/>
    <!-- sits on top of the body -->
    <origin xyz="0 0 ${body_height/2 + tray_thick/2}" rpy="0 0 0"/>
  </joint>
    <!-- ===================== 9. LiDAR (Module 5) ===================== -->
  <link name="laser_link">
    <!-- the sensor head -->
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry>
      <material name="black"/>
    </visual>
    <!-- the post it stands on, down to the top of the body -->
    <visual>
      <origin xyz="0 0 ${-(lidar_length/2 + post_length/2)}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.01" length="${post_length}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry>
    </collision>
    <xacro:box_inertia m="${lidar_mass}" x="${2*lidar_radius}" y="${2*lidar_radius}" z="${lidar_length}"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <!-- base_link is at body_z, so subtract it to get the height above the ground -->
    <origin xyz="${lidar_x} 0 ${lidar_z - body_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== 8. Gazebo extras ===================== -->
  <xacro:include filename="$(find chassis_description)/urdf/chassis.gazebo.xacro"/>
  <!-- ===================== 8. Gazebo extras ===================== -->
  <xacro:include filename="$(find chassis_description)/urdf/chassis.gazebo.xacro"/>


</robot>
