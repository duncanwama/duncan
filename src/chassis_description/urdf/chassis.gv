digraph G {
node [shape=box];
"base_footprint" [label="base_footprint"];
"base_link" [label="base_link"];
"caster_link" [label="caster_link"];
"left_wheel" [label="left_wheel"];
"right_wheel" [label="right_wheel"];
"tray_link" [label="tray_link"];
node [shape=ellipse, color=blue, fontcolor=blue];
"base_footprint" -> "base_joint" [label="xyz: 0 0 0.08 \nrpy: 0 -0 0"]
"base_joint" -> "base_link"
"base_link" -> "caster_joint" [label="xyz: -0.15 0 -0.05 \nrpy: 0 -0 0"]
"caster_joint" -> "caster_link"
"base_link" -> "left_wheel_joint" [label="xyz: 0.12 0.175 -0.03 \nrpy: 0 -0 0"]
"left_wheel_joint" -> "left_wheel"
"base_link" -> "right_wheel_joint" [label="xyz: 0.12 -0.175 -0.03 \nrpy: 0 -0 0"]
"right_wheel_joint" -> "right_wheel"
"base_link" -> "tray_joint" [label="xyz: 0 0 0.055 \nrpy: 0 -0 0"]
"tray_joint" -> "tray_link"
}
