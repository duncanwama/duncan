<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One simulated motor, commanded by position, for one joint -->
  <xacro:macro name="joint_transmission" params="joint">
    <transmission name="${joint}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint}">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${joint}_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <!-- Arm joints -->
  <xacro:joint_transmission joint="joint1"/>
  <xacro:joint_transmission joint="joint2"/>
  <xacro:joint_transmission joint="joint3"/>
  <xacro:joint_transmission joint="joint4"/>
  <xacro:joint_transmission joint="joint5"/>
  <xacro:joint_transmission joint="joint6"/>

  <!-- Gripper joints -->
  <xacro:joint_transmission joint="left_finger_joint"/>
  <xacro:joint_transmission joint="right_finger_joint"/>

</robot>
