<?xml version="1.0"?>
<sdf version="1.6">
  <world name="table_cube">
  <plugin name="ros_link_attacher_plugin" filename="libgazebo_ros_link_attacher.so"/>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Table: one solid static block -->
    <model name="table">
      <static>true</static>
      <pose>0.375 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 0.40 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 0.40 0.30</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Wood</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- Red cube: NOT static, so it can be picked up -->
    <model name="red_cube">
      <pose>0.30 0 0.32 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <!-- solid cube: m * s^2 / 6 = 0.05 * 0.04^2 / 6 -->
          <inertia>
            <ixx>1.33e-5</ixx> <ixy>0</ixy> <ixz>0</ixz>
            <iyy>1.33e-5</iyy> <iyz>0</iyz>
            <izz>1.33e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Red</name>
          </script></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
