<?xml version="1.0"?>
<!-- colour_cubes.world - a grey table with a red, a green and a blue cube (Module 3.6.3, Step 5) -->
<sdf version="1.6">
  <world name="colour_cubes">
    <plugin name="ros_link_attacher_plugin" filename="libgazebo_ros_link_attacher.so"/>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="table">
      <static>true</static>
      <pose>0.375 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.25 0.40 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.25 0.40 0.30</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- White drop zone: flat and visual only -->
    <model name="drop_zone">
      <static>true</static>
      <pose>0.30 0 0.3005 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.06 0.06 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <model name="red_cube">
      <pose>0.30 -0.13 0.32 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass>
          <inertia><ixx>1.33e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.33e-5</iyy><iyz>0</iyz><izz>1.33e-5</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <model name="green_cube">
      <pose>0.30 -0.02 0.32 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass>
          <inertia><ixx>1.33e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.33e-5</iyy><iyz>0</iyz><izz>1.33e-5</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <model name="blue_cube">
      <pose>0.30 0.13 0.32 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass>
          <inertia><ixx>1.33e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.33e-5</iyy><iyz>0</iyz><izz>1.33e-5</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
